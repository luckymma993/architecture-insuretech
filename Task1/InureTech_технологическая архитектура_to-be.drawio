<mxfile host="app.diagrams.net" version="24.7.11"><diagram name="to-be" id="tobe1"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="Зона доступности 1 (Москва)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=none;verticalAlign=bottom;fontSize=18;arcSize=6;align=left;spacingLeft=30;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="520" height="640" as="geometry"/></mxCell><mxCell id="c12" value="Зона доступности 2 (Москва-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=none;verticalAlign=bottom;fontSize=18;arcSize=6;align=left;spacingLeft=30;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="520" height="640" as="geometry"/></mxCell><mxCell id="c13" value="Зона доступности 3 (Новосибирск)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3ebff;strokeColor=none;verticalAlign=bottom;fontSize=18;arcSize=6;align=left;spacingLeft=30;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="520" height="640" as="geometry"/></mxCell><mxCell id="c14" value="Пользователи из разных регионов РФ&lt;br&gt;(браузер, мобильное приложение)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=middle;fontSize=15;arcSize=6;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="360" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Партнёры (B2B API,&lt;br&gt;до 20 RPS на партнёра)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=middle;fontSize=15;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="300" height="90" as="geometry"/></mxCell><mxCell id="c16" value="Cloud DNS&lt;br&gt;гео-маршрутизация + health check, TTL 30 с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=middle;fontSize=14;arcSize=6;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="380" height="100" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="75" y="222" width="32" height="32" as="geometry"/></mxCell><mxCell id="c18" value="Cloud CDN&lt;br&gt;статика веб-приложения (SPA), кэш рядом с пользователем" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=middle;fontSize=14;arcSize=6;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="190" width="380" height="100" as="geometry"/></mxCell><mxCell id="c19" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1175" y="222" width="32" height="32" as="geometry"/></mxCell><mxCell id="c20" value="Application Load Balancer 1 (L7)&lt;br&gt;HTTPS, health check HTTP /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=middle;fontSize=14;arcSize=6;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="460" height="110" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="85" y="559" width="32" height="32" as="geometry"/></mxCell><mxCell id="c22" value="Kubernetes-кластер 1&lt;br&gt;(независимый)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=top;fontSize=14;arcSize=6;spacingLeft=50;align=left;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="460" height="190" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="85" y="702" width="32" height="32" as="geometry"/></mxCell><mxCell id="c24" value="InsureTech namespace&lt;br&gt;core-app, client-info,&lt;br&gt;ins-product-aggregator:&lt;br&gt;≥3 реплики, HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=middle;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="270" y="720" width="240" height="140" as="geometry"/></mxCell><mxCell id="c25" value="VM 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=top;fontSize=14;arcSize=6;spacingLeft=50;align=left;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="70" y="940" width="460" height="140" as="geometry"/></mxCell><mxCell id="c26" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="85" y="952" width="32" height="32" as="geometry"/></mxCell><mxCell id="c27" value="PostgreSQL (master)&lt;br&gt;Patroni + etcd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=middle;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="270" y="960" width="240" height="100" as="geometry"/></mxCell><mxCell id="c28" value="HTTP, health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="TCP 5432 (запись: leader,&lt;br&gt;чтение: локальная реплика)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Application Load Balancer 2 (L7)&lt;br&gt;HTTPS, health check HTTP /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=middle;fontSize=14;arcSize=6;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="650" y="520" width="460" height="110" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="665" y="559" width="32" height="32" as="geometry"/></mxCell><mxCell id="c32" value="Kubernetes-кластер 2&lt;br&gt;(независимый)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=top;fontSize=14;arcSize=6;spacingLeft=50;align=left;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="650" y="690" width="460" height="190" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="665" y="702" width="32" height="32" as="geometry"/></mxCell><mxCell id="c34" value="InsureTech namespace&lt;br&gt;core-app, client-info,&lt;br&gt;ins-product-aggregator:&lt;br&gt;≥3 реплики, HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=middle;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="850" y="720" width="240" height="140" as="geometry"/></mxCell><mxCell id="c35" value="VM 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5282ff;verticalAlign=top;fontSize=14;arcSize=6;spacingLeft=50;align=left;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="650" y="940" width="460" height="140" as="geometry"/></mxCell><mxCell id="c36" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="665" y="952" width="32" height="32" as="geometry"/></mxCell><mxCell id="c37" value="PostgreSQL (sync-реплика)&lt;br&gt;Patroni + etcd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=middle;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="850" y="960" width="240" height="100" as="geometry"/></mxCell><mxCell id="c38