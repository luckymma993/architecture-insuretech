wrap;verticalAlign=middle;fontSize=14;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="1230" y="520" width="460" height="110" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1245" y="559" width="32" height="32" as="geometry"/></mxCell><mxCell id="c44" value="Kubernetes-кластер 3&lt;br&gt;(независимый)&lt;br&gt;readiness/liveness&lt;br&gt;probe (health check)" style="shape=stencil(vVNdD4IgFP01PMpIms1ns//BEpVF4K6U9u/DoFJxPdjm2/04cO65cBDN2po1HMWkNaAvvBOFqRE9ojgWquYgjI0QzRHNSg28An1ThcsbNiCH6Krvww29O0eGEzF5uCwleP8qnByWwdk2wWMpTg8ODm88TlwhQHjAjniCPmK9aCPQhhmh1YRcMqh4ZLmiUrJq0mo7zpug7KeTQo2UpAkmdJF8pZjP7PPlbCAm4PazrZQS7mazZwm+xF9vsryVDWT89okNvgYrhZTOn+P+3JC25MxM8yc=);strokeColor=#5282ff;fillColor=#ffffff;gradientColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=14;spacingLeft=50;align=left;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1230" y="690" width="460" height="190" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="1245" y="702" width="32" height="32" as="geometry"/></mxCell><mxCell id="c46" value="InsureTech namespace&lt;br&gt;core-app, client-info,&lt;br&gt;ins-product-aggregator:&lt;br&gt;≥3 реплики, HPA" style="shape=stencil(vVPLEoIgFP0aljgEVuPa6j+YRGUica6U9vdhUKk4LWzG3X0cOPdcOIilTclrgShpDOiLaGVmSsQOiFJZlQKksRFiR8TSXIMoQN+qzOU175F9dNX3/obOnSP9CUoeLktIFL8KJ4flcLZN8NhtRJiDwxsf7VwhQHjAhniCDvNONhi04UbqakSuOBQCWy6cK16MWk0rRB2U/XRKVgMlSRwl+1nyhWI+s0+Xs4KYgNvPtlBKuJvVniX4En+9yfxWVpDx2yc2+Bosl0o5fw77U0PakjMzOz4B);strokeColor=#ff5958;fillColor=#ffffff;gradientColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1430" y="720" width="240" height="140" as="geometry"/></mxCell><mxCell id="c47" value="VM 3" style="shape=stencil(vVNdD4IgFP01PMpIms1ns//BEpVF4K6U9u/DoFJxPdjm2/04cO65cBDN2po1HMWkNaAvvBOFqRE9ojgWquYgjI0QzRHNSg28An1ThcsbNiCH6Krvww29O0eGEzF5uCwleP8qnByWwdk2wWMpTg8ODm88TlwhQHjAjniCPmK9aCPQhhmh1YRcMqh4ZLmiUrJq0mo7zpug7KeTQo2UpAkmdJF8pZjP7PPlbCAm4PazrZQS7mazZwm+xF9vsryVDWT89okNvgYrhZTOn+P+3JC25MxM8yc=);strokeColor=#5282ff;fillColor=#ffffff;gradientColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=14;spacingLeft=50;align=left;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1230" y="940" width="460" height="140" as="geometry"/></mxCell><mxCell id="c48" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="1245" y="952" width="32" height="32" as="geometry"/></mxCell><mxCell id="c49" value="PostgreSQL (async-реплика)&lt;br&gt;Patroni + etcd&lt;br&gt;health check: Patroni REST /replica" style="shape=stencil(vVPLEoIgFP0aljgEVuPa6j+YRGUica6U9vdhUKk4LWzG3X0cOPdcOIilTclrgShpDOiLaGVmSsQOiFJZlQKksRFiR8TSXIMoQN+qzOU175F9dNX3/obOnSP9CUoeLktIFL8KJ4flcLZN8NhtRJiDwxsf7VwhQHjAhniCDvNONhi04UbqakSuOBQCWy6cK16MWk0rRB2U/XRKVgMlSRwl+1nyhWI+s0+Xs4KYgNvPtlBKuJvVniX4En+9yfxWVpDx2yc2+Bosl0o5fw77U0PakjMzOz4B);strokeColor=#ff5958;fillColor=#ffffff;gradientColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1430" y="960" width="240" height="100" as="geometry"/></mxCell><mxCell id="c50" value="HTTP, health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c42" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="TCP 5432 (запись: leader,&lt;br&gt;чтение: локальная реплика)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c46" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.92;exitY=1;entryX=0.92;entryY=0;" edge="1" parent="1" source="c46" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="Object Storage (бэкапы)&lt;br&gt;WAL-G: WAL-архив каждые 5 мин + полный бэкап раз в сутки,&lt;br&gt;реплика бакета в другой регион" style="shape=stencil(vVNdD4IgFP01PMpIms1ns//BEpVF4K6U9u/DoFJxPdjm2/04cO65cBDN2po1HMWkNaAvvBOFqRE9ojgWquYgjI0QzRHNSg28An1ThcsbNiCH6Krvww29O0eGEzF5uCwleP8qnByWwdk2wWMpTg8ODm88TlwhQHjAjniCPmK9aCPQhhmh1YRcMqh4ZLmiUrJq0mo7zpug7KeTQo2UpAkmdJF8pZjP7PPlbCAm4PazrZQS7mazZwm+xF9vsryVDWT89okNvgYrhZTOn+P+3JC25MxM8yc=);strokeColor=#5282ff;fillColor=#ffffff;gradientColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="740" y="1230" width="440" height="110" as="geometry"/></mxCell><mxCell id="c54" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="755" y="1269" width="32" height="32" as="geometry"/></mxCell><mxCell id="c55" value="Monitoring + алерты&lt;br&gt;метрики и health check зон, БД, реплик, SLO 99,9%" style="shape=stencil(vVNdD4IgFP01PMpIms1ns//BEpVF4K6U9u/DoFJxPdjm2/04cO65cBDN2po1HMWkNaAvvBOFqRE9ojgWquYgjI0QzRHNSg28An1ThcsbNiCH6Krvww29O0eGEzF5uCwleP8qnByWwdk2wWMpTg8ODm88TlwhQHjAjniCPmK9aCPQhhmh1YRcMqh4ZLmiUrJq0mo7zpug7KeTQo2UpAkmdJF8pZjP7PPlbCAm4PazrZQS7mazZwm+xF9vsryVDWT89okNvgYrhZTOn+P+3JC25MxM8yc=);strokeColor=#5282ff;fillColor=#ffffff;gradientColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=13;spacingLeft=50;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="380" height="110" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1"><mxGeometry x="55" y="1269" width="32" height="32" as="geometry"/></mxCell><mxCell id="c57" value="1. DNS-запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="DNS-запрос" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="статика" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="2. HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="health check&lt;br&gt;HTTPS /health, 10 с" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c14" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="health check&lt;br&gt;HTTPS /health, 10 с" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c16" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c14" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="health check&lt;br&gt;HTTPS /health, 10 с" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.7;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c16" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="sync-репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c27" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="etcd: health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.85;entryX=0;entryY=0.85;" edge="1" parent="1" source="c27" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="etcd: health check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c38" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="async-репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c27" target="c49"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="1190"/><mxPoint x="1550" y="1190"/></Array></mxGeometry></mxCell><mxCell id="c70" value="метрики, алерты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ff5958;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.8;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="c55" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="бэкап" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2875E2;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c38" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="&lt;b&gt;1. Масштабирование и зоны&lt;/b&gt;&lt;br&gt;&lt;br&gt;Выбрано горизонтальное масштабирование: сервисы в Kubernetes stateless, ≥3 реплики каждого в каждой зоне, HPA по CPU/памяти. Вертикальный рост одной площадки не даёт 99,9% и не защищает от потери ЦОД. БД: мастер растёт вертикально (50 GB умещаются на одном узле), чтение масштабируется репликами.&lt;br&gt;Используем три зоны доступности в режиме active-active: потеря любой зоны оставляет 2/3 ёмкости, каждая зона рассчитана на ≥50% пика. Зоны 1 и 2 находятся в одном регионе (Москва), зона 3 в удалённом регионе (Новосибирск), это сокращает задержку для пользователей из разных часовых поясов. Допущение: в Yandex Cloud все зоны доступности относятся к одному региону, поэтому удалённая площадка арендуется отдельно или в другом облаке, а гео-маршрутизацию (GSLB) обеспечивает DNS-сервис с поддержкой геолокации и health check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="520" height="330" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;2. Kubernetes: независимые кластеры&lt;/b&gt;&lt;br&gt;&lt;br&gt;В каждой зоне свой независимый кластер, растянутый кластер не используем.&lt;br&gt;Почему: у растянутого кластера общий control plane и etcd, на задержке до Новосибирска 50+ мс он нестабилен и сам становится единой точкой отказа. Независимые кластеры ограничивают аварию одной зоной и позволяют обновлять зоны по очереди (canary).&lt;br&gt;Цена: деплой в три кластера. Решается GitOps: один репозиторий манифестов, CI/CD раскатывает по зонам последовательно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="620" y="1390" width="520" height="250" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;3. Балансировка и health check&lt;/b&gt;&lt;br&gt;&lt;br&gt;DNS с гео-маршрутизацией (GSLB) возвращает адрес ALB ближайшей здоровой зоны. Health check DNS → ALB: HTTPS /health каждые 10 с, 3 неудачи подряд исключают зону из ответа.&lt;br&gt;Внутри зоны ALB (L7) распределяет трафик по подам: HTTP health check /health, в Kubernetes настроены readiness и liveness probe. Статика SPA отдаётся из CDN.&lt;br&gt;Лимит запросов на партнёра (20 RPS по договору) задаётся на ALB, чтобы один партнёр не забирал ресурсы остальных." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1390" width="520" height="250" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;4. Failover на уровне клиента&lt;/b&gt;&lt;br&gt;&lt;br&gt;При падении зоны health check убирает её из DNS-ответа (TTL 30 с, итого 1–2 мин). Клиент повторяет запрос (retry с backoff, 3 попытки) и получает адрес живой зоны. Подключения без состояния: запрос можно обслужить в любой зоне. Статика продолжает отдаваться из CDN, даже если бэкенд недоступен. Время переключения &lt; 5 мин при RTO 45 мин." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="520" height="190" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;5. БД: RTO 45 мин, RPO 15 мин&lt;/b&gt;&lt;br&gt;&lt;br&gt;Кластер Patroni + etcd (3 узла, по одному в зоне, кворум 2 из 3). Master в зоне 1, синхронная реплика в зоне 2 (RPO = 0 при потере зоны 1), асинхронная в зоне 3 (лаг секунды, укладывается в RPO 15 мин). Автофейловер Patroni 30–60 с. Приложение находит leader по Patroni REST (health check /primary), читает с локальной реплики.&lt;br&gt;Бэкапы: WAL-G в Object Storage: WAL каждые 5 мин (потеря ≤ 5 мин даже при потере всех зон БД) + полный бэкап раз в сутки, хранение 14 дней, реплика бакета в другой регион. Восстановление 50 GB ≈ 15–20 мин &lt; RTO 45 мин. Проверка восстановления раз в квартал.&lt;br&gt;Если недоступны сразу обе московские зоны, у etcd остаётся 1 узел из 3 (нет кворума), и автофейловер Patroni не работает. Тогда мастер поднимается вручную из бэкапа WAL-G или промоутом async-реплики из зоны 3 (по регламенту), это укладывается в RTO 45 мин.&lt;br&gt;Запись из зоны 3 идёт на master в зоне 1 (дополнительная задержка около 50–80 мс на запрос). Это принято сознательно: страницы и справочники читаются с локальной реплики и из CDN, а записи (оформление заявки) редкие, 10 RPS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="620" y="1740" width="520" height="380" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;6. Шардирование БД: не применяем&lt;/b&gt;&lt;br&gt;&lt;br&gt;50 GB умещаются на одном сервере. Шардирование усложнит транзакции оформления страховок и запросы по клиенту без выигрыша. Нагрузку на чтение снимаем репликами, на запись — ростом мастера и пулером соединений (PgBouncer).&lt;br&gt;Вернёмся к шардированию по client_id, если данных станет больше 1–2 TB или запись упрётся в мастер. Решение пересматриваем по метрикам Monitoring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;fontSize=13;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1200" y="1740" width="520" height="210" as="geometry"/></mxCell><mxCell id="c78" value="Легенда&lt;br&gt;сплошная синяя: штатный трафик&lt;br&gt;пунктир красный: health check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontSize=12;arcSize=6;align=left;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1200" y="1230" width="340" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>